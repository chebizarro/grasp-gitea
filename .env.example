GITEA_URL=http://gitea:3000
GITEA_ADMIN_TOKEN=
# Required: public URL prefix for git clone URLs (must match NIP-34 clone tags)
CLONE_PREFIX=https://git.example.com
RELAY_URLS=ws://gastown-relay:3334
HOOK_RELAY_URL=ws://localhost:3334
HOOK_BINARY_PATH=/usr/local/bin/grasp-pre-receive
GITEA_REPOSITORIES_PATH=/gitea-data/git/repositories
LISTEN=:8090
DB_PATH=./mappings.db
# Immutable pointer to the durable mutable-policy projection.
GRASP_CONFIG_PATH=/data/config.json
# One-time bootstrap trust roots for signed kind-30078 policy authors. Existing
# GRASP_CONFIG_PATH state always wins; change roots through authenticated local recovery.
GRASP_CONFIG_TRUSTED_AUTHORS=
GRASP_CONFIG_SCOPE=prod
PUBKEY_ALLOWLIST=
PROVISION_RATE_LIMIT=10
ADMIN_API_TOKEN=

# Optional: public URL for bridge callbacks/challenges where applicable.
BRIDGE_PUBLIC_URL=
# Optional: NIP-46 challenge/session TTL (Go duration, default 5m).
CHALLENGE_TTL=5m

# Nostr web login (NIP-07/46/55). Requires BRIDGE_PUBLIC_URL.
AUTH_ENABLED=false

# Scoped Gitea service identity for the unauthenticated public GRASP git path.
# Anonymous requests are served only when the repository is publicly readable.
GIT_BACKEND_USER=
GIT_BACKEND_PASSWORD=

# Graceful shutdown. Must outlast in-flight pushes and package uploads, and
# your orchestrator's stop timeout must exceed it. (Previously hardcoded 5s.)
SHUTDOWN_GRACE=5m

# NIP-34 outbound publishing (PRs, issues, patches, labels)
# SIGNET_BUNKER_URL: Signet/NIP-46 bunker URL for server/operator signing.
# Required for production outbound 30618 fallback/webhook events and CI kind:5401.
SIGNET_BUNKER_URL=
# BRIDGE_NSEC: Development-only local fallback. Rejected when GRASP_ENV/APP_ENV/ENVIRONMENT=production.
BRIDGE_NSEC=
# GITEA_WEBHOOK_SECRET: HMAC secret shared with Gitea system webhook.
GITEA_WEBHOOK_SECRET=

# Hive-CI Tier A: local act runner for NIP-34 push/PR checks.
HIVE_CI_ENABLED=false
HIVE_CI_ACT_PATH=/usr/bin/act
# Legacy one-time seed inputs. They are read only when GRASP_CONFIG_PATH does
# not exist; edit hive_ci through /admin/policy/hive_ci afterwards.
# NOSTR_RELAYS=wss://relay.example.com
# CASHU_MINT_URL=https://mint.example.com
# BLOSSOM_URL=https://blossom.example.com
# JOB_TIMEOUT_MINUTES=15
# HIVECI_CLONE_URL_TEMPLATE=https://git.example.com/{owner}/{repo}.git

# User-signed NIP-46 migration
# SIGNER_MASTER_KEY: 32-byte base64 or hex key used to encrypt persisted NIP-46
# signer grants. Setting this enables user-signing: owner/contributor events are
# built unsigned, queued in the outbox, then signed via the user's bunker grant.
# Leave empty to run in legacy bridge-signed transition mode.
SIGNER_MASTER_KEY=

# --- Nostr authentication for all Gitea surfaces (opt-in) -------------------
# Lets a Nostr identity authenticate to Gitea HTTP surfaces with a bridge
# token instead of Gitea credentials. Enable in this order: full proxy and the
# nginx cutover FIRST, bridge tokens afterwards.
# See docs/fullproxy-cutover-runbook.md and docs/UPGRADING.md.

# Route ALL Gitea traffic through the bridge. Requires the full-proxy nginx
# config (deploy/nginx/gitea-vhost.conf.example) and an unpublished Gitea port.
GITEA_FULL_PROXY_ENABLED=false

# Authenticates the nginx session-handoff continuation. Authorizes arbitrary
# X-Grasp-Auth-User impersonation, so it must be high entropy (>= 43 chars):
#   openssl rand -base64 32
# Required when GITEA_FULL_PROXY_ENABLED=true and AUTH_ENABLED=true.
GRASP_EDGE_SHARED_SECRET=

# NIP-98-authenticated bridge tokens (grasp_v1_...) exchanged at the proxy edge
# for hidden per-user Gitea PATs. Requires AUTH_ENABLED,
# GITEA_FULL_PROXY_ENABLED, GITEA_ADMIN_USER, GRASP_CREDENTIAL_KEYS, and
# BRIDGE_PUBLIC_URL; the bridge refuses to start otherwise.
BRIDGE_TOKENS_ENABLED=false

# Login of the administrator owning GITEA_ADMIN_TOKEN. Gitea gates its
# user-token endpoints behind Basic auth, so the username is required too.
GITEA_ADMIN_USER=

# AES-256-GCM key ring protecting hidden Gitea PATs at rest, newest first:
#   current:<base64 32 bytes>[,previous:<base64 32 bytes>]
# Generate: echo "current:$(openssl rand -base64 32)"
# BACK THIS UP: losing every key makes stored PATs undecryptable.
GRASP_CREDENTIAL_KEYS=

# Bridge token lifetime bounds and audit retention.
BRIDGE_TOKEN_TTL_DEFAULT=720h
BRIDGE_TOKEN_TTL_MIN=1h
BRIDGE_TOKEN_TTL_MAX=2160h
AUTH_AUDIT_RETENTION=2160h

# Proactive sync / archive behavior
# PROACTIVE_SYNC_INTERVAL: how often the bridge checks repository state for
# best-effort local ref updates (Go duration; default 1h).
PROACTIVE_SYNC_INTERVAL=1h

# Nostr kind:0 profile sync (NIP-01/NIP-24 -> Gitea user profile)
# PROFILE_SYNC_ENABLED: keep linked users' Gitea profile (display name, bio,
# website, custom avatar) in sync with their Nostr kind:0. Independent of
# bridge tokens; requires GITEA_ADMIN_USER (admin edit + ephemeral avatar PAT).
PROFILE_SYNC_ENABLED=false
# PROFILE_SYNC_INTERVAL: how often every linked identity's kind:0 is re-fetched
# (Go duration, 1m-24h; default 10m).
PROFILE_SYNC_INTERVAL=10m
# PROFILE_SYNC_WORKERS: concurrent per-user sync workers (1-32; default 4).
PROFILE_SYNC_WORKERS=4

# GRASP05_ARCHIVE_MODE: when true, archive local repositories when later owner
# announcements remove this server from clone tags.
GRASP05_ARCHIVE_MODE=false
