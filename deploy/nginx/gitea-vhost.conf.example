# Nginx vhost template for grasp-gitea.
# Replace YOUR_DOMAIN with your actual git domain (must match CLONE_PREFIX).

server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name YOUR_DOMAIN;

    # TLS cert/key are expected to be managed by your existing nginx setup.
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    client_max_body_size 1g;

    # GRASP-01 npub git smart-HTTP: public /<npub>/<percent-encoded-id>.git
    # clone/fetch/push paths must go to the bridge. The bridge resolves the
    # npub+identifier mapping and reverse-proxies to Gitea's real /<org>/<repo>.git
    # path with fixed GRASP-01 CORS headers. Human/org Gitea paths continue to
    # fall through to Gitea directly via location / below.
    location ~ ^/npub1[^/]+/.+\.git/(info/refs|git-upload-pack|git-receive-pack)$ {
        proxy_pass http://grasp-bridge:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://gitea:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
