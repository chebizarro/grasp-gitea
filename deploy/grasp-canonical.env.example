# Canonical GRASP-01 single-hostname configuration (sharegap issue #2).
# grasp.sharegap.net serves all three surfaces:
#   wss://grasp.sharegap.net/          -> Nostr relay (WebSocket upgrade on /)
#   https://grasp.sharegap.net/        -> NIP-11 (Accept: application/nostr+json)
#   https://grasp.sharegap.net/<npub>/<percent-encoded-id>.git -> git smart HTTP

# Canonical service origins. When GRASP_PUBLIC_URL is set, announcement
# acceptance requires clone=<GRASP_PUBLIC_URL>/<npub>/<id>.git and
# relays=<GRASP_RELAY_URL>, and bridge-emitted events advertise them.
GRASP_PUBLIC_URL=https://grasp.sharegap.net
GRASP_RELAY_URL=wss://grasp.sharegap.net

# The bridge itself is the canonical public endpoint.
BRIDGE_PUBLIC_URL=https://grasp.sharegap.net
CLONE_PREFIX=https://grasp.sharegap.net

# Relay served at the same origin (full build / embedded relay, or an
# externally multiplexed relay at /).
EMBEDDED_RELAY=true
# EMBEDDED_RELAY already adds its local endpoint to the subscriber. Do not
# subscribe to the same relay again through its public hostname: doing so can
# reflect identical events back into the embedded relay indefinitely.
RELAY_URLS=
HOOK_RELAY_URL=wss://grasp.sharegap.net

# Scoped Gitea service identity for the unauthenticated public git path.
# Gitea itself stays private (container network only).
GIT_BACKEND_USER=grasp-bridge
GIT_BACKEND_PASSWORD=change-me
