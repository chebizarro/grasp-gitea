# Canonical GRASP-01 single-hostname configuration (sharegap issue #2).
# grasp.sharegap.net serves all surfaces:
#   wss://grasp.sharegap.net/          -> Nostr relay WebSocket
#   https://grasp.sharegap.net/        -> NIP-11 when Accept is application/nostr+json
#   https://grasp.sharegap.net/        -> Gitea UI for ordinary browser requests
#   https://grasp.sharegap.net/<npub>/<percent-encoded-id>.git -> git smart HTTP
#
# NIP-07/NIP-46 web-session handoff is cookie-bound and therefore requires the
# bridge auth routes and Gitea UI to use this same HTTPS origin.

GRASP_PUBLIC_URL=https://grasp.sharegap.net
GRASP_RELAY_URL=wss://grasp.sharegap.net
BRIDGE_PUBLIC_URL=https://grasp.sharegap.net
CLONE_PREFIX=https://grasp.sharegap.net

EMBEDDED_RELAY=true
RELAY_URLS=

# Hooks run inside the Gitea container. Use container-network addresses, never
# localhost or the public edge hostname, for relay/admin checks.
HOOK_RELAY_URL=ws://grasp-bridge:3334
GRASP_HOOK_ADMIN_URL=http://grasp-bridge:8090
GRASP_HOOK_ADMIN_TOKEN_FILE=/run/secrets/grasp-admin-api-token
GRASP_ADMIN_TOKEN_FILE=./secrets/grasp-admin-api-token

# Fail-closed pre-receive bounds (defaults shown).
GRASP_HOOK_TIMEOUT=15s
GRASP_HOOK_MAX_NOSTR_UPDATES=16
GRASP_HOOK_MAX_NOSTR_REFS=256
GRASP_HOOK_MAX_PACK_BYTES=268435456
GRASP_HOOK_MAX_OBJECTS=50000
GRASP_HOOK_MAX_OBJECT_BYTES=536870912
GRASP_HOOK_MAX_SINGLE_OBJECT_BYTES=67108864

# Scoped Gitea service identity for the unauthenticated public git path.
# Gitea itself stays private (container network only).
GIT_BACKEND_USER=grasp-bridge
GIT_BACKEND_PASSWORD=change-me

# --- Full-proxy mode + Nostr authentication for all Gitea surfaces ----------
# See docs/fullproxy-cutover-runbook.md. Enable in the documented order:
# full proxy and the nginx cutover first, bridge tokens only afterwards.

# Route ALL Gitea traffic through the bridge. Requires the full-proxy nginx
# config (deploy/nginx/gitea-vhost.conf.example) and an unpublished Gitea port.
GITEA_FULL_PROXY_ENABLED=false

# Authenticates the nginx session-handoff continuation. Authorizes arbitrary
# X-Grasp-Auth-User impersonation, so it must be high entropy:
#   openssl rand -base64 32
# Required when GITEA_FULL_PROXY_ENABLED=true and AUTH_ENABLED=true.
GRASP_EDGE_SHARED_SECRET=

# NIP-98-authenticated bridge tokens (grasp_v1_...) exchanged at the proxy
# edge for hidden per-user Gitea PATs. Requires AUTH_ENABLED,
# GITEA_FULL_PROXY_ENABLED, GITEA_ADMIN_USER, GRASP_CREDENTIAL_KEYS,
# and BRIDGE_PUBLIC_URL.
BRIDGE_TOKENS_ENABLED=false

# Login of the administrator owning GITEA_ADMIN_TOKEN. Gitea's user-token
# endpoints require Basic auth, so the bridge needs the username too.
GITEA_ADMIN_USER=

# AES-256-GCM key ring protecting hidden PATs at rest, newest first:
#   current:<base64 32 bytes>[,previous:<base64 32 bytes>]
# Generate with: echo "current:$(openssl rand -base64 32)"
# BACK THIS UP. Losing every key makes stored PATs undecryptable.
GRASP_CREDENTIAL_KEYS=

# Bridge token lifetime bounds.
BRIDGE_TOKEN_TTL_DEFAULT=720h
BRIDGE_TOKEN_TTL_MIN=1h
BRIDGE_TOKEN_TTL_MAX=2160h

# Authentication audit retention.
AUTH_AUDIT_RETENTION=2160h

# Graceful shutdown must outlast in-flight pushes and package uploads.
SHUTDOWN_GRACE=5m
